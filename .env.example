# =============================================================================
# Health Intelligence Platform — Proactive Knowledge Stream
# Copy this file to .env and fill in your values
# =============================================================================

# --- App ---
APP_NAME="Knowledge Stream API"
APP_VERSION="0.1.0"
DEBUG=false
LOG_LEVEL=INFO
API_PREFIX=/api/v1
ADMIN_SECRET=change-me-in-production

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=knowledge_stream
POSTGRES_USER=ks_user
POSTGRES_PASSWORD=ks_password
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=knowledge_chunks

# --- MinIO ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_RAW=raw-artifacts
MINIO_BUCKET_EXTRACTED=extracted-text

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- Temporal ---
TEMPORAL_HOST=localhost
TEMPORAL_PORT=7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=knowledge-stream-queue

# --- LLM Routing (ModelGateway) ---
# Primary: DeepSeek V3
MODEL_PRIMARY=deepseek/deepseek-chat
MODEL_PRIMARY_API_KEY=your-deepseek-api-key-here
MODEL_PRIMARY_API_BASE=https://api.deepseek.com

# Secondary: Gemini
MODEL_SECONDARY=gemini/gemini-1.5-pro
MODEL_SECONDARY_API_KEY=your-gemini-api-key-here

# Tertiary: OpenAI
MODEL_TERTIARY=gpt-4o-mini
MODEL_TERTIARY_API_KEY=your-openai-api-key-here

# Routing
MODEL_CONFIDENCE_THRESHOLD=0.6
MODEL_MAX_RETRIES=3

# --- Embedding (deferred — finalize before Batch 5) ---
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=your-openai-api-key-here
EMBEDDING_DIMENSIONS=1536
